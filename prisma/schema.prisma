generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
model Teacher { id String @id @default(cuid()) email String? @unique name String createdAt DateTime @default(now()) templates AssessmentTemplate[] moderations TeacherModeration[] }
model AssessmentTemplate { id String @id @default(cuid()) title String part String genre String question String expectedWordRange String? compulsorySentence String? acceptedInterpretations String? noAwardConditions String? createdAt DateTime @default(now()) teacherId String? teacher Teacher? @relation(fields:[teacherId], references:[id]) contentParameters ContentParameter[] submissions Submission[] }
model ContentParameter { id String @id @default(cuid()) code String requirement String templateId String template AssessmentTemplate @relation(fields:[templateId], references:[id], onDelete: Cascade) }
model Student { id String @id @default(cuid()) name String className String? submissions Submission[] }
model Submission { id String @id @default(cuid()) studentId String student Student @relation(fields:[studentId], references:[id]) templateId String? template AssessmentTemplate? @relation(fields:[templateId], references:[id]) examinationName String? part String genre String question String expectedWordRange String? compulsorySentence String? essayText String wordCount Int createdAt DateTime @default(now()) aiMarking AIMarking? moderation TeacherModeration? }
model AIMarking { id String @id @default(cuid()) submissionId String @unique submission Submission @relation(fields:[submissionId], references:[id], onDelete: Cascade) rawJson Json contentScore Int caScore Int organisationScore Int languageScore Int total Int confidence Float requiresTeacherReview Boolean createdAt DateTime @default(now()) }
model TeacherModeration { id String @id @default(cuid()) submissionId String @unique submission Submission @relation(fields:[submissionId], references:[id], onDelete: Cascade) teacherId String? teacher Teacher? @relation(fields:[teacherId], references:[id]) contentScore Int? caScore Int? organisationScore Int? languageScore Int? total Int? note String? approved Boolean @default(false) createdAt DateTime @default(now()) }
model BenchmarkEssay { id String @id @default(cuid()) title String originalEssay String part String genre String contentScore Int caScore Int organisationScore Int languageScore Int total Int teacherComments String? createdAt DateTime @default(now()) }
